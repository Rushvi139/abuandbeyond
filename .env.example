# Copy to .env and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://abuandbeyond.in
APP_PORT=3100                                # local port the app listens on; Traefik points here

# Database (our own Postgres container). Pick a long random password:  openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_USER=abu
POSTGRES_DB=abuandbeyond
BACKUP_KEEP_DAYS=14
# For local development outside Docker only:
# DATABASE_URL=postgres://abu:<password>@localhost:5433/abuandbeyond

# Staff login sessions: long random string  (openssl rand -hex 32)
SESSION_SECRET=

# Razorpay (Dashboard -> Account & Settings -> API keys). Use TEST keys until go-live.
# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Shared server with Traefik (our Hostinger VPS)
COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
TRAEFIK_NETWORK=root_default
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=mytlschallenge

# Only for an empty server using the bundled Caddy (--profile caddy)
DOMAIN=

# Cashfree Payments — Dashboard > Developers > API Keys.
# Test keys start with TEST / cfsk_ma_test_. The same secret signs webhooks.
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox (default) or production — this also switches the API host
CASHFREE_ENV=sandbox
# The token the dashboard makes you generate when adding a webhook endpoint.
# Webhooks are accepted if they match this OR the API secret above.
CASHFREE_WEBHOOK_SECRET=
