# Copy to .env.local and fill in. Never commit real values.

# App
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # production: https://abuandbeyond.in

# Supabase (Project settings -> API). Region: Mumbai (ap-south-1)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server only, never exposed to the browser

# Razorpay (Dashboard -> Account & Settings -> API keys). Use TEST keys until go-live.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=            # set when adding the webhook to /api/razorpay/webhook

# WhatsApp Cloud API (Meta for Developers -> WhatsApp -> API setup)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=              # any random string; used by /api/whatsapp/webhook
WHATSAPP_APP_SECRET=                # to verify inbound webhook signatures

# Server deploy (docker-compose)
DOMAIN=                             # only for --profile caddy on an empty server: abuandbeyond.in
APP_PORT=3100                       # local port the app listens on; your proxy points here

# Shared server with Traefik (Hostinger VPS): uncomment and match the server's Traefik
# COMPOSE_FILE=docker-compose.yml:docker-compose.traefik.yml
# TRAEFIK_NETWORK=root_default          # network root-traefik-1 is on
# TRAEFIK_ENTRYPOINT=websecure          # Traefik's HTTPS entrypoint name
# TRAEFIK_CERTRESOLVER=mytlschallenge   # Traefik's certificate resolver name
